import React, { useMemo, useRef, useState } from 'react';
import {
  CheckCircle2,
  Camera,
  Pencil,
  Search,
  Plus,
  ShieldCheck,
} from 'lucide-react';
import { useApp } from '../context/AppContext';

export const VerifiedBadge: React.FC<{ className?: string }> = ({
  className = 'w-4 h-4 text-amber-400 inline-block ml-1',
}) => <CheckCircle2 className={className} />;

interface ProfileViewProps {
  userId?: string;
  isModal?: boolean;
  onClose?: () => void;
}

export const ProfileView: React.FC<ProfileViewProps> = ({ isModal, onClose }) => {
  const {
    userProfile,
    updateUserProfile,
    reels,
    favorites,
    movies,
    toggleFavorite,
    handleUploadMedia,
  } = useApp();

  const [nameDraft, setNameDraft] = useState(userProfile.name);
  const [bioDraft, setBioDraft] = useState(userProfile.bio || '');
  const imageInputRef = useRef<HTMLInputElement | null>(null);
  const videoInputRef = useRef<HTMLInputElement | null>(null);

  const favoriteMovies = useMemo(
    () => movies.filter((m) => favorites.includes(m.id)),
    [movies, favorites],
  );

  const handleProfileSave = async () => {
    await updateUserProfile({
      name: nameDraft,
      bio: bioDraft,
    });
  };

  const handleUploadProfile = async (file: File, target: 'profile' | 'cover') => {
    const type = file.type.includes('video') ? 'video' : 'image';
    const url = await handleUploadMedia(file, type, target);
    if (url && target === 'profile') {
      await updateUserProfile({ avatar: url });
    }
    if (url && target === 'cover') {
      await updateUserProfile({ coverPhoto: url, coverType: type === 'video' ? 'video' : 'image' });
    }
  };

  const avatar = userProfile.avatar || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=200&auto=format&fit=crop&q=80';
  const cover = userProfile.coverPhoto || 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=1200&auto=format&fit=crop&q=80';

  return (
    <div className="min-h-screen bg-[#05070b] text-white">
      <div className="mx-auto max-w-md pb-24">
        <div className="px-3 pt-3">
          <div className="flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-2 text-xs text-zinc-300">
            <Search className="h-4 w-4 text-zinc-400" />
            <input
              value={nameDraft}
              onChange={(e) => setNameDraft(e.target.value)}
              className="w-full bg-transparent text-sm text-white placeholder:text-zinc-500 outline-none"
              placeholder="بحث"
            />
            <div className="flex items-center gap-2">
              <span className="rounded-full bg-[#f5c518] px-2 py-1 text-[10px] font-black text-black">VIP</span>
              <span className="rounded-full border border-white/10 px-2 py-1 text-[10px] text-zinc-200">AI</span>
            </div>
          </div>
        </div>

        <div className="px-3 pt-3">
          <div className="overflow-hidden rounded-[30px] border border-white/10 bg-zinc-900 shadow-[0_20px_50px_rgba(0,0,0,0.5)]">
            <div
              className="relative h-44 w-full bg-cover bg-center"
              style={{ backgroundImage: `url(${cover})` }}
            >
              <div className="absolute inset-0 bg-gradient-to-r from-black/80 via-black/55 to-black/20" />
              <div className="absolute inset-x-0 top-3 flex items-center justify-between px-3">
                <div className="flex items-center gap-2 text-[10px] text-zinc-200">
                  <button className="rounded-full border border-white/10 bg-black/30 px-2 py-1">تعديل الملف</button>
                </div>
                <button className="rounded-full border border-white/10 bg-black/30 p-2" onClick={() => imageInputRef.current?.click()}>
                  <Camera className="h-3.5 w-3.5" />
                </button>
              </div>
            </div>

            <div className="relative -mt-12 px-4 pb-4">
              <div className="flex items-center justify-between">
                <div className="relative">
                  <img
                    src={avatar}
                    alt={userProfile.name}
                    className="h-20 w-20 rounded-full border-4 border-[#0b0d12] object-cover shadow-[0_0_25px_rgba(245,197,24,0.35)]"
                  />
                  <button
                    className="absolute -bottom-1 -right-1 flex h-7 w-7 items-center justify-center rounded-full border-2 border-[#0b0d12] bg-[#ff3b30] text-white"
                    onClick={() => imageInputRef.current?.click()}
                  >
                    <Plus className="h-4 w-4" />
                  </button>
                </div>

                <div className="flex items-center gap-2">
                  <button className="rounded-full border border-white/10 bg-white/5 px-3 py-2 text-[10px] font-bold text-white">
                    متابعة
                  </button>
                  <button className="rounded-full bg-[#dd2a2a] px-3 py-2 text-[10px] font-bold text-white">
                    + متابعة
                  </button>
                </div>
              </div>

              <div className="mt-4 flex items-center gap-2">
                <h2 className="text-2xl font-black leading-none">{userProfile.name}</h2>
                <VerifiedBadge />
              </div>

              <div className="mt-1 text-xs font-medium text-zinc-400">@{userProfile.username || 'filmmax_user'}</div>

              <div className="mt-4 flex justify-between gap-3">
                <div className="flex-1 rounded-2xl border border-white/10 bg-white/5 p-3 text-center">
                  <div className="text-2xl font-black text-white">18.5K</div>
                  <div className="text-[10px] text-zinc-400">إعجابات</div>
                </div>
                <div className="flex-1 rounded-2xl border border-white/10 bg-white/5 p-3 text-center">
                  <div className="text-2xl font-black text-white">2.4M</div>
                  <div className="text-[10px] text-zinc-400">متابع</div>
                </div>
                <div className="flex-1 rounded-2xl border border-white/10 bg-white/5 p-3 text-center">
                  <div className="text-2xl font-black text-white">0</div>
                  <div className="text-[10px] text-zinc-400">منشورات</div>
                </div>
              </div>

              <div className="mt-4 flex gap-2">
                <button className="flex-1 rounded-full bg-[#e50914] px-4 py-2.5 text-sm font-black text-white">
                  نشر ريلز
                </button>
                <button className="flex-1 rounded-full border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-bold text-white">
                  إضافة قصة
                </button>
              </div>

              <div className="mt-4 rounded-2xl border border-white/10 bg-[#0d1017] p-3">
                <div className="mb-2 flex items-center justify-between text-xs text-zinc-400">
                  <span>حسابي</span>
                  <ShieldCheck className="h-3.5 w-3.5 text-emerald-400" />
                </div>
                <p className="text-sm leading-6 text-zinc-200">
                  {bioDraft || userProfile.bio || 'عاشق للسينما العالمية والـ 4K HDR. أستمتع بالمؤثرات والهوية البصرية المميزة.'}
                </p>
              </div>
            </div>
          </div>
        </div>

        <div className="px-3 pt-4">
          <div className="rounded-[28px] border border-white/10 bg-[#0d1017] p-4">
            <div className="mb-3 flex items-center justify-between">
              <h3 className="text-lg font-black text-white">تعديل الملف الشخصي</h3>
              <Pencil className="h-4 w-4 text-zinc-400" />
            </div>

            <div className="space-y-3">
              <div>
                <label className="mb-1 block text-[10px] text-zinc-400">الاسم الكامل</label>
                <input
                  value={nameDraft}
                  onChange={(e) => setNameDraft(e.target.value)}
                  className="w-full rounded-2xl border border-white/10 bg-black/30 px-3 py-2.5 text-sm text-white outline-none ring-0 placeholder:text-zinc-500"
                  placeholder="ادخل الاسم"
                />
              </div>

              <div>
                <label className="mb-1 block text-[10px] text-zinc-400">نبذة</label>
                <textarea
                  value={bioDraft}
                  onChange={(e) => setBioDraft(e.target.value)}
                  className="h-24 w-full resize-none rounded-2xl border border-white/10 bg-black/30 px-3 py-2.5 text-sm text-white outline-none placeholder:text-zinc-500"
                  placeholder="اكتب نبذة قصيرة"
                />
              </div>

              <div className="flex gap-2">
                <button
                  onClick={() => imageInputRef.current?.click()}
                  className="flex-1 rounded-full bg-white/5 px-4 py-2 text-xs font-bold text-white"
                >
                  تغيير الصورة
                </button>
                <button
                  onClick={handleProfileSave}
                  className="flex-1 rounded-full bg-[#ff2d55] px-4 py-2 text-xs font-black text-white"
                >
                  حفظ
                </button>
              </div>
            </div>
          </div>
        </div>

        <div className="px-3 pt-4">
          <div className="mb-3 flex items-center justify-between">
            <h3 className="text-lg font-black text-white">قائمة المفضلة</h3>
            <span className="text-xs text-zinc-400">{favoriteMovies.length}</span>
          </div>

          <div className="grid grid-cols-2 gap-3">
            {favoriteMovies.slice(0, 4).map((movie) => (
              <div key={String(movie.id)} className="overflow-hidden rounded-2xl border border-white/10 bg-zinc-900">
                <img src={movie.poster} alt={movie.title} className="h-44 w-full object-cover" />
                <div className="p-2">
                  <div className="truncate text-xs font-bold text-white">{movie.title}</div>
                  <button
                    onClick={() => toggleFavorite(movie.id)}
                    className="mt-2 rounded-full bg-white/5 px-2 py-1 text-[10px] text-zinc-200"
                  >
                    إزالة
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div className="px-3 pt-4">
          <div className="mb-3 flex items-center justify-between">
            <h3 className="text-lg font-black text-white">ريلزك</h3>
            <span className="text-xs text-zinc-400">{reels.filter((r) => r.isUserCreated || r.userId === userProfile.id).length}</span>
          </div>

          <div className="grid grid-cols-2 gap-3">
            {reels.filter((r) => r.isUserCreated || r.userId === userProfile.id).slice(0, 4).map((reel) => (
              <div key={String(reel.id)} className="overflow-hidden rounded-2xl border border-white/10 bg-zinc-900">
                <img src={reel.poster || reel.thumbnailUrl || avatar} alt={reel.title} className="h-44 w-full object-cover" />
                <div className="p-2">
                  <div className="truncate text-xs font-bold text-white">{reel.title}</div>
                  <div className="mt-1 text-[10px] text-zinc-400">{reel.likesCount} إعجاب</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <input
        ref={imageInputRef}
        type="file"
        accept="image/jpeg,image/png,image/webp"
        className="hidden"
        onChange={(e) => {
          const file = e.target.files?.[0];
          if (file) handleUploadProfile(file, 'cover');
        }}
      />
      <input
        ref={videoInputRef}
        type="file"
        accept="video/mp4,video/webm,video/quicktime"
        className="hidden"
        onChange={(e) => {
          const file = e.target.files?.[0];
          if (file) handleUploadProfile(file, 'cover');
        }}
      />
    </div>
  );
};

