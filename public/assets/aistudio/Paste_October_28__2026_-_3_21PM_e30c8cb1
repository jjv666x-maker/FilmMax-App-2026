            </div>

            <div className="bg-black/20 rounded-2xl p-3">
              <div className="text-white/60">مسلسلات</div>
              <div className="text-2xl font-bold">{userProfile.seriesCompleted || 14}</div>
            </div>

            <div className="bg-black/20 rounded-2xl p-3">
              <div className="text-white/60">VIP</div>
              <div className="text-2xl font-bold">نشط</div>
            </div>
          </div>
        </div>
      </div>

      <div className="mt-8">
        <h3 className="text-xl font-bold mb-4">قائمة المفضلة</h3>

        <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
          {favoriteMovies.slice(0, 8).map((movie) => (
            <div key={String(movie.id)} className="group relative rounded-3xl overflow-hidden">
              <img src={movie.poster} alt={movie.title} className="h-60 w-full object-cover" />
              <div className="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent" />
              <div className="absolute bottom-0 left-0 right-0 p-3">
                <div className="font-bold text-white">{movie.title}</div>
                <button
                  onClick={() => toggleFavorite(movie.id)}
                  className="mt-2 bg-white/15 text-white px-2 py-1 rounded-full text-xs"
                >
                  إزالة من المفضلة
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div className="mt-8">
        <h3 className="text-xl font-bold mb-4">ريلزك</h3>

        <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
          {reels.filter((reel) => reel.isUserCreated || reel.userId === userProfile.id).slice(0, 8).map((reel) => (
            <div key={String(reel.id)} className="rounded-3xl overflow-hidden bg-white/5 border border-white/10">
              <img
