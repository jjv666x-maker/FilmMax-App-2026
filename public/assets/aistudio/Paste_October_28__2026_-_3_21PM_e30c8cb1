import React, { useMemo, useRef, useState } from 'react';
import { useApp } from '../context/AppContext';

export const ProfileView: React.FC = () => {
  const {
    userProfile,
    updateUserProfile,
    reels,
    favorites,
    movies,
    toggleFavorite,
    addStory,
    handleUploadMedia
  } = useApp();

  const [nameDraft, setNameDraft] = useState(userProfile.name);
  const [bioDraft, setBioDraft] = useState(userProfile.bio || '');
  const [coverMode, setCoverMode] = useState<'image' | 'video' | 'color'>(
    userProfile.coverType || 'image'
  );

  const imageInputRef = useRef<HTMLInputElement | null>(null);
  const videoInputRef = useRef<HTMLInputElement | null>(null);

  const favoriteMovies = useMemo(
    () => movies.filter((m) => favorites.includes(m.id)),
    [movies, favorites]
  );

  const handleProfileSave = async () => {
    await updateUserProfile({
      name: nameDraft,
      bio: bioDraft
    });
  };

  const handleUploadProfile = async (file: File, target: 'profile' | 'cover') => {
    const type = file.type.includes('video') ? 'video' : 'image';
    const url = await handleUploadMedia(file, type, target);
    if (url && target === 'profile') {
      await updateUserProfile({ avatar: url });
    }
    if (url && target === 'cover') {
      await updateUserProfile({ coverPhoto: url, coverType: type === 'video' ? 'video' : 'image' });
    }
  };

  return (
    <div className="max-w-6xl mx-auto pb-20">
      <div className="rounded-[28px] overflow-hidden shadow-2xl border border-white/10">
        <div
          className="relative h-64 w-full"
          style={{
            backgroundImage:
              coverMode === 'color'
                ? `linear-gradient(135deg, ${userProfile.coverPhoto || '#111827'}, #000)`
                : `url(${userProfile.coverPhoto})`,
            backgroundSize: 'cover',
            backgroundPosition: 'center',
            transform: `scale(${userProfile.coverZoom ?? 1}) translateY(${userProfile.coverOffsetY ?? 0}px)`
          }}
        >
          <div className="absolute inset-0 bg-black/35" />
          <div className="relative z-10 flex items-end justify-between h-full p-5">
            <div className="flex items-center gap-4">
              <img
                src={userProfile.avatar}
                alt={userProfile.name}
                className="w-24 h-24 rounded-full border-4 border-white shadow-xl object-cover"
              />
              <div className="text-white">
                <h2 className="text-3xl font-bold">{userProfile.name}</h2>
                <p className="text-sm opacity-90">@{userProfile.username || 'filmmax_user'}</p>
              </div>
            </div>

            <div className="flex gap-2">
              <button
                className="bg-white/10 text-white px-3 py-2 rounded-full text-sm backdrop-blur"
                onClick={() => imageInputRef.current?.click()}
              >
                صورة غلاف
              </button>
              <button
                className="bg-red-600 text-white px-3 py-2 rounded-full text-sm"
                onClick={() => videoInputRef.current?.click()}
              >
                فيديو غلاف
              </button>
            </div>
          </div>
        </div>

        <input
          ref={imageInputRef}
          type="file"
          accept="image/jpeg,image/png,image/webp"
          className="hidden"
          onChange={(e) => {
            const file = e.target.files?.[0];
            if (file) handleUploadProfile(file, 'cover');
          }}
        />

        <input
          ref={videoInputRef}
          type="file"
          accept="video/mp4,video/webm,video/quicktime"
          className="hidden"
          onChange={(e) => {
            const file = e.target.files?.[0];
            if (file) handleUploadProfile(file, 'cover');
          }}
        />
      </div>

      <div className="mt-6 grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-6">
        <div className="bg-white/5 border border-white/10 rounded-3xl p-5">
          <h3 className="text-xl font-bold mb-4">تعديل الحساب</h3>

          <div className="space-y-4">
            <div>
              <label className="text-sm text-white/70 block mb-1">الاسم</label>
              <input
                value={nameDraft}
                onChange={(e) => setNameDraft(e.target.value)}
                className="w-full rounded-2xl bg-black/20 border border-white/10 px-4 py-3 text-white"
              />
            </div>

            <div>
              <label className="text-sm text-white/70 block mb-1">السيرة</label>
              <textarea
                value={bioDraft}
                onChange={(e) => setBioDraft(e.target.value)}
                className="w-full h-28 rounded-2xl bg-black/20 border border-white/10 px-4 py-3 text-white"
              />
            </div>

            <div className="flex gap-3">
              <button
                onClick={() => {
                  const input = document.createElement('input');
                  input.type = 'file';
                  input.accept = 'image/jpeg,image/png,image/webp';
                  input.onchange = async () => {
                    const file = input.files?.[0];
                    if (file) {
                      const url = await handleUploadMedia(file, 'image', 'profile');
                      if (url) await updateUserProfile({ avatar: url });
                    }
                  };
                  input.click();
                }}
                className="bg-white text-black px-4 py-2 rounded-full font-bold"
              >
                تغيير الصورة
              </button>

              <button
                onClick={handleProfileSave}
                className="bg-red-600 text-white px-4 py-2 rounded-full font-bold"
              >
                حفظ التغييرات
              </button>
            </div>
          </div>
        </div>

        <div className="bg-white/5 border border-white/10 rounded-3xl p-5">
          <h3 className="text-xl font-bold mb-4">الإحصائيات</h3>

          <div className="grid grid-cols-2 gap-3 text-sm">
            <div className="bg-black/20 rounded-2xl p-3">
