              <div className="p-3">
                <div className="text-sm font-bold truncate">{reel.title}</div>
                <div className="text-xs text-white/60 mt-1">{reel.description}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
};
