# ==============================================================================
# FilmMax Platform - Environment Variables Template
# All keys are completely OPTIONAL with graceful offline/mock fallbacks.
# ==============================================================================

# 1. TMDB Catalog API (Optional: pre-configured fallback key included)
TMDB_API_KEY=0a8bc15ab94b56a8244de54c87c8f661

# 2. Sentry Observability & Error Tracking (Optional)
# If left empty, errors are logged and buffered locally with PII scrubbing.
VITE_SENTRY_DSN=

# 3. OpenTelemetry Distributed Tracing (Optional)
# Target OTLP HTTP endpoint (e.g., http://localhost:4318 or SigNoz/Jaeger endpoint)
OTEL_EXPORTER_OTLP_ENDPOINT=

# 4. Stripe Payments & VIP Subscriptions (Optional)
# If left empty, automated simulated checkout and testing modes are active.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 5. Cloud Storage & CDN Distribution (Optional: AWS S3 / Cloudflare R2 / GCS)
# If left empty, media files and HLS streams are served directly from local /public/streams.
AWS_REGION=us-east-1
AWS_BUCKET_NAME=filmmax-media-cdn
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_DOMAIN=
